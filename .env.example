# Karoulette configuration. Copy to .env (setup.sh does this for you).

# Host port the app is published on (container listens on 8000).
KQ_PORT=8095

# Host folder for the SQLite database. On TrueNAS use a dataset, e.g. /mnt/tank/apps/karoulette
KQ_DATA_DIR=./data

# Owner of the data folder inside the container (568 = TrueNAS "apps" user).
PUID=568
PGID=568

# PIN or password for the host screen and admin. Required. 4 characters minimum, but use 8+ or a
# passphrase if Karoulette is reachable from the internet.
HOST_PIN=

# YouTube Data API v3 key (server-side only, never sent to browsers).
# Leave blank to use the slower yt-dlp metadata search fallback.
YOUTUBE_API_KEY=
YOUTUBE_DAILY_QUOTA=10000

# Address Karoulette listens on. 0.0.0.0 = the whole LAN (TV and phones on Wi-Fi). Use 127.0.0.1 when
# everyone comes in through a reverse proxy or Cloudflare Tunnel on this host.
KQ_BIND=0.0.0.0

# Proxies allowed to pass the real client address (X-Forwarded-For). Never use *: anyone could fake their
# address and get past the login and search limits. The default covers this host and Docker networks.
KQ_TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12

# Content-Security-Policy: report (default, logs problems in the browser console), enforce, or off.
CSP_MODE=report

# Public site address guests use (for the QR code), e.g. https://karaoke.example.ca
# Just the site root: /join/<code> is added automatically. Blank = the address the TV opened.
PUBLIC_BASE_URL=

# Optional: Client ID of your Spotify app, for Spotify playlists (or set it in Host admin -> Song history).
SPOTIFY_CLIENT_ID=

# Optional: contact for push alert services, e.g. mailto:you@example.ca (blank = PUBLIC_BASE_URL if HTTPS).
VAPID_SUBJECT=

# Signs host session cookies. setup.sh generates one; blank = auto-generated in the data folder.
SECRET_KEY=

# Updates: a daily check for new releases of this GitHub repository, shown in Host admin > Updates.
UPDATE_CHECK=true
SOURCE_REPO=parabyte-ca/karoulette
# Host folder shared with the upgrade helper (scripts/upgrade-agent.sh) for one-click upgrades.
KQ_UPGRADE_FOLDER=./upgrade

# Set to false to disable the yt-dlp fallback search.
ENABLE_YTDLP=true

# Image to run. Set KQ_IMAGE=ghcr.io/parabyte-ca/karoulette to pull prebuilt images instead of building.
KQ_IMAGE=parabyte-ca/karoulette
KQ_TAG=latest

TZ=America/Toronto
