# KaraokeQueue configuration. Copy to .env (setup.sh does this for you).

# Host port the app is published on (container listens on 8000).
KQ_PORT=8095

# Host folder for the SQLite database. On TrueNAS use a dataset, e.g. /mnt/tank/apps/karaokequeue
KQ_DATA_DIR=./data

# Owner of the data folder inside the container (568 = TrueNAS "apps" user).
PUID=568
PGID=568

# PIN or password for the host screen and admin (4+ characters). Required.
HOST_PIN=

# YouTube Data API v3 key (server-side only, never sent to browsers).
# Leave blank to use the slower yt-dlp metadata search fallback.
YOUTUBE_API_KEY=
YOUTUBE_DAILY_QUOTA=10000

# Public URL guests use (for the QR code), e.g. https://karaoke.example.ca
# Leave blank to use whatever address the host screen was opened with.
PUBLIC_BASE_URL=

# Signs host session cookies. setup.sh generates one; blank = auto-generated in the data folder.
SECRET_KEY=

# Set to false to disable the yt-dlp fallback search.
ENABLE_YTDLP=true

# Image to run. Set KQ_IMAGE=ghcr.io/parabyte-ca/karaokequeue to pull prebuilt images instead of building.
KQ_IMAGE=parabyte-ca/karaokequeue
KQ_TAG=latest

TZ=America/Toronto
